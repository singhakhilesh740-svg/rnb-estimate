rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == '112ce0489@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // har user ka apna profile — sirf wahi padh/likh sakta hai, owner sabka padh sakta hai
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;

      // saved estimates — sirf us user ki, owner ko read access
      match /estimates/{eid} {
        allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
